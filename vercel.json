{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/ask",
      "destination": "/ask.html"
    },
    {
      "source": "/solve",
      "destination": "/solve.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    }
  ]
}
